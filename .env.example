# Copy to .env for local use. Never commit .env.
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=WEALTHOPS_WH
SNOWFLAKE_DATABASE=WEALTHOPS_DB
SNOWFLAKE_SCHEMA=STAGING
# If password authentication is used instead, set:
# SNOWFLAKE_PASSWORD=...

